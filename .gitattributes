# 默认：仓库内统一 LF，检出时按需转换
* text=auto eol=lf

# Windows 批处理必须是 CRLF：cmd.exe 解析 LF 换行的 .cmd/.bat 会出错，
# 且报错与真实原因毫无关联（sts2-mcp 踩过）。
*.cmd  text eol=crlf
*.bat  text eol=crlf

# PowerShell 脚本同样 CRLF；含中文的 .ps1 还必须是 UTF-8 with BOM。
*.ps1  text eol=crlf
*.psm1 text eol=crlf

# 项目文件遵循 Windows 工具链惯例
*.vcxproj text eol=crlf
*.sln     text eol=crlf

# 二进制，禁止任何转换
*.dll binary
*.exe binary
*.pdb binary
*.png binary
*.v3  binary
